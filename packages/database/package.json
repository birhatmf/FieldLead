{
  "name": "@fieldlead/database",
  "version": "0.1.0",
  "private": true,
  "description": "FieldLead Prisma schema, migration ve veritabani erisim paketi",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "prisma generate && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3"
  }
}
