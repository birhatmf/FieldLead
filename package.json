{
  "name": "fieldlead",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "FieldLead - Saha araştırma ve lead toplama platformu",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w @fieldlead/database",
    "db:generate": "npm run prisma:generate -w @fieldlead/database",
    "db:studio": "npm run prisma:studio -w @fieldlead/database"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
